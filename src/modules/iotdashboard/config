#!/usr/bin/env bash

USE_QEMU=1

# Add
[ -n "$IOTDASHBOARD_ADD_MIDNIGHT_COMMANDER" ] || IOTDASHBOARD_ADD_MIDNIGHT_COMMANDER=yes

# Remove console messages from boot and a quiet load
[ -n "$IOTDASHBOARD_QUIET_BOOT" ] || IOTDASHBOARD_QUIET_BOOT=yes

# Rotate screen Normal(0), 90(1), 180(2), 270(3) grades
[ -n "$IOTDASHBOARD_ROTATE_SCREEN" ] || IOTDASHBOARD_ROTATE_SCREEN=1

[ -n "$IOTDASHBOARD_INCLUDE_APP" ] || IOTDASHBOARD_INCLUDE_APP=yes
[ -n "$IOTDASHBOARD_PORT" ] || IOTDASHBOARD_PORT=8080
[ -n "$IOTDASHBOARD_DASHBOARD_SERVICE" ] || IOTDASHBOARD_DASHBOARD_SERVICE=iot-dashboard.service
[ -n "$IOTDASHBOARD_READER_SERVICE" ] || IOTDASHBOARD_READER_SERVICE=iot-sensor-reader.service
