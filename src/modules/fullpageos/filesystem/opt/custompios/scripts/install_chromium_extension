#!/bin/bash
# install-chromium-extension.sh

EXTENSION_ID="cjabmkimbcmhhepelfhjhbhonnapiipj"
POLICY_DIR="/etc/chromium/policies/managed"

# Create policy directory
sudo mkdir -p "$POLICY_DIR"

# Install extension via policy
cat << EOF | sudo tee "$POLICY_DIR/extensions.json"
{
  "ExtensionInstallForcelist": [
    "${EXTENSION_ID};https://clients2.google.com/service/update2/crx"
  ],
  "ExtensionSettings": {
    "${EXTENSION_ID}": {
      "installation_mode": "force_installed",
      "update_url": "https://clients2.google.com/service/update2/crx"
    }
  }
}
EOF

# Set permissions
sudo chmod 644 "$POLICY_DIR/extensions.json"

echo "Extension policy installed. Restart Chromium to apply."
